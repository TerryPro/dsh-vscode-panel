{
  "name": "@lsq64737/dsh-workbench-layout",
  "version": "0.2.0",
  "description": "DSH-styled three-column workspace with file editing, Markdown preview, Git controls, terminals, and native conversation",
  "author": "lsq64737",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerryPro/dsh-vscode-panel.git"
  },
  "bugs": {
    "url": "https://github.com/TerryPro/dsh-vscode-panel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/mermaid-runtime.js",
    "lib/kernel-bridge.py",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && tsdown && node scripts/copy-kernel-bridge.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:bundle": "node scripts/smoke-client-bundle.mjs",
    "test:kernel": "npm run build && node scripts/probe-kernel.mjs",
    "test:example": "npm run build && node scripts/probe-example.mjs",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "lightningcss": "^1.30.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-terminal-controller": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-terminal-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.1.1",
    "mermaid": "11.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
